# AcadAssist Environment Configuration (Example)
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Microsoft Foundry / Azure AI Projects
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project-id>
FOUNDRY_PROJECT=acadassist-foundry
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small
FOUNDRY_AGENT_NAME=AcadAssist

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_INDEX=acadassist-index

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=<your_storage_account_name>
AZURE_STORAGE_CONTAINER=study-materials

# Application Settings
DATABASE_URL=postgresql://user:password@localhost:5432/acadassist
ENVIRONMENT=development
LOG_LEVEL=INFO
